paperlink-menu-process =
    .label = PaperLink: find local PDF & check duplicates
paperlink-pref-search = Find papers you already downloaded
paperlink-pref-enabled =
    .label = Process papers saved with the Zotero Connector automatically
paperlink-pref-folders = Folders to search:
paperlink-pref-browse =
    .label = Choose…
paperlink-pref-depth = Subfolder levels to search:
paperlink-pref-confirm =
    .label = Ask before linking a match based only on the title (DOI, arXiv ID and identical files never ask)
paperlink-pref-found = When the paper is already on disk
paperlink-pref-copy-ask =
    .label = Link the existing PDF, then ask whether to permanently delete Zotero's download
paperlink-pref-copy-delete =
    .label = Link the existing PDF and permanently delete Zotero's download without asking (annotated copies are kept)
paperlink-pref-copy-keep =
    .label = Link the existing PDF and keep Zotero's download too
paperlink-pref-notfound = When the paper is not on disk
paperlink-pref-nomatch-move =
    .label = Save the downloaded PDF into the folder below and link it (turn off ZotMoov's auto-move)
paperlink-pref-nomatch-keep =
    .label = Keep the PDF in Zotero storage (lets ZotMoov handle it)
paperlink-pref-move-target = Save new PDFs to (empty = first folder above):
paperlink-pref-dups = Duplicate entries
paperlink-pref-dup-check =
    .label = Check whether a newly saved paper is already in the library
paperlink-pref-dup-ask =
    .label = Ask: merge / keep both / show duplicates
paperlink-pref-dup-merge =
    .label = Merge into the older entry automatically
paperlink-pref-dup-ignore =
    .label = Do nothing (manual menu still checks)
paperlink-pref-notify =
    .label = Show a notification after each processed paper
paperlink-pref-find-missing =
    .label = If no PDF arrives (or the linked file was deleted), download one with Zotero's "Find Available PDF"
